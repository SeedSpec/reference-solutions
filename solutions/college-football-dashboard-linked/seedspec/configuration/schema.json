{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "College Football Program Dashboard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dashboard_name",
    "season",
    "timezone",
    "favorite_team_id",
    "teams",
    "ranking_sources",
    "comparison_metrics",
    "freshness",
    "default_view"
  ],
  "properties": {
    "dashboard_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "season": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "favorite_team_id": {
      "$ref": "#/$defs/localId"
    },
    "teams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "short_name", "accent_color"],
        "properties": {
          "id": {
            "$ref": "#/$defs/localId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "short_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    },
    "ranking_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["ap", "coaches", "cfp"]
      }
    },
    "comparison_metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "win-percentage",
          "points-per-game",
          "points-allowed-per-game",
          "total-offense-yards-per-game",
          "total-defense-yards-allowed-per-game",
          "turnover-margin"
        ]
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_scores_seconds",
        "schedules_minutes",
        "rankings_hours",
        "statistics_hours"
      ],
      "properties": {
        "live_scores_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "schedules_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "rankings_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "statistics_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      }
    },
    "default_view": {
      "enum": ["overview", "schedule", "comparison"]
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
