{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operations Dashboard Starter Kit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_name",
    "record_model",
    "metrics",
    "freshness",
    "views",
    "actions",
    "exports"
  ],
  "properties": {
    "workspace_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "record_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singular", "plural", "statuses"],
      "properties": {
        "singular": { "type": "string", "minLength": 1, "maxLength": 40 },
        "plural": { "type": "string", "minLength": 1, "maxLength": 40 },
        "statuses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "definition", "format", "aggregation"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "definition": { "type": "string", "minLength": 1, "maxLength": 500 },
          "format": { "enum": ["number", "percent", "duration", "currency"] },
          "aggregation": { "enum": ["count", "sum", "average", "median", "ratio"] }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stale_after_minutes"],
      "properties": {
        "stale_after_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        }
      }
    },
    "views": {
      "enum": ["private-only", "private-and-team"]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment", "status_change", "bulk_actions"],
      "properties": {
        "assignment": { "type": "boolean" },
        "status_change": { "type": "boolean" },
        "bulk_actions": { "type": "boolean" }
      }
    },
    "exports": {
      "enum": ["disabled", "authorized-view"]
    }
  }
}
